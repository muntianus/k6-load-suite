{
  "name": "k6-load-suite",
  "version": "1.0.0",
  "description": "Deterministic k6 performance scenarios, HAR-to-k6 converter, and SLO threshold service for PerfOps & Globex",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "smoke": "k6 run --vus 1 --duration 10s smoke.js",
    "smoke:globlex": "k6 run --vus 1 --duration 10s scenarios/globlex-enterprise-slo.js",
    "smoke:perfops": "k6 run --vus 1 --duration 10s scenarios/perfops-gateway-slo.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
